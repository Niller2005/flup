{
	"name": "flup.app",
	"version": "0.0.1",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"lucide-svelte": "^1.0.1",
		"mode-watcher": "^1.1.0",
		"pocketbase-typegen": "^1.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"private": true,
	"scripts": {
		"setup": "bash scripts/setup-pocketbase.sh",
		"dev": "concurrently -k -n pb,app -c blue,green \"bun run dev:pb\" \"bun run dev:app\"",
		"dev:app": "vite dev --port 5173",
		"dev:pb": "./pocketbase serve --http=127.0.0.1:8090 --dir=./pb_data --migrationsDir=./pb_migrations",
		"dev:pb:isolated": "./pocketbase serve --http=127.0.0.1:8090 --dir=./pb_data_dev --migrationsDir=./pb_migrations",
		"pb": "./pocketbase",
		"pb:migrate": "./pocketbase migrate",
		"pb:backup": "./pocketbase backup",
		"pb:types": "if [ -z \"$PUBLIC_POCKETBASE_URL\" ] || [ -z \"$POCKETBASE_ADMIN_EMAIL\" ] || [ -z \"$POCKETBASE_ADMIN_PASSWORD\" ]; then echo \"ERROR: Set PUBLIC_POCKETBASE_URL, POCKETBASE_ADMIN_EMAIL, POCKETBASE_ADMIN_PASSWORD in .env before running pb:types (Bun auto-loads .env)\" >&2; exit 1; fi; bunx pocketbase-typegen --url \"$PUBLIC_POCKETBASE_URL\" --email \"$POCKETBASE_ADMIN_EMAIL\" --password \"$POCKETBASE_ADMIN_PASSWORD\" --out src/lib/pocketbase/types.ts",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"type": "module",
	"dependencies": {
		"pocketbase": "0.27.0"
	}
}
